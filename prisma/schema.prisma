generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String      @id
  name                String
  email               String
  emailVerified       Boolean     @default(false)
  image               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  sessions            Session[]
  accounts            Account[]
  onboarding          Onboarding?

  skills   UserSkill[]
  roadmaps CareerRoadmap[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Onboarding {
  id        String  @id @default(uuid())
  userId    String  @unique
  completed Boolean @default(false)

  currentStatus      String
  targetRole         String
  skills             String[] @default([])
  experienceTypes    String[] @default([])
  projectCount       String?
  relevantExperience String?

  mainGoal     String?
  weeklyTime   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding")
}

enum SkillLevel {
  UNKNOWN
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SkillSource {
  ONBOARDING
  USER_ADDED
  ROADMAP
  ASSESSMENT
}

enum RoadmapGenerationStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum RoadmapLifecycle {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RoadmapTaskType {
  LEARN
  PRACTICE
  PROJECT
  REVIEW
}

enum RoadmapTaskStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model UserSkill {
  id             String     @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  level          SkillLevel @default(UNKNOWN)
  source         SkillSource @default(USER_ADDED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([userId, level])
  @@map("user_skill")
}

model CareerRoadmap {
  id             String                   @id @default(uuid())
  userId         String
  targetRole     String
  title          String
  summary        String                   @db.Text
  generationStatus RoadmapGenerationStatus @default(PENDING)
  lifecycle      RoadmapLifecycle         @default(ACTIVE)

  // Increment when this roadmap is regenerated.
  version        Int      @default(1)
  templateVersion String?
  modelUsed      String?

  // Operational metadata; never store API keys here.
  generationStartedAt DateTime?
  generationFinishedAt DateTime?
  lastError            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages RoadmapStage[]

  @@index([userId, lifecycle])
  @@index([generationStatus, createdAt])
  @@map("career_roadmap")
}

model RoadmapStage {
  id          String @id @default(uuid())
  roadmapId   String
  title       String
  description String @db.Text
  order       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roadmap CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  tasks RoadmapTask[]

  @@unique([roadmapId, order])
  @@index([roadmapId])
  @@map("roadmap_stage")
}

model RoadmapTask {
  id             String           @id @default(uuid())
  stageId        String
  title          String
  description    String           @db.Text
  type           RoadmapTaskType
  status         RoadmapTaskStatus @default(LOCKED)
  order          Int

  // Skill names this task develops or demonstrates.
  skills         String[]         @default([])

  estimatedHours Float?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage     RoadmapStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  resources RoadmapResource[]

  @@unique([stageId, order])
  @@index([stageId, status])
  @@map("roadmap_task")
}

model RoadmapResource {
  id       String @id @default(uuid())
  taskId   String
  label    String
  provider String
  url      String @db.Text

  createdAt DateTime @default(now())

  task RoadmapTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("roadmap_resource")
}

